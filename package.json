{
  "name": "swag",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3030",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "db:import-nirvana": "tsx --env-file-if-exists=.env src/db/import-nirvana.ts",
    "export:participants": "tsx --env-file-if-exists=.env scripts/export-participants.ts",
    "study:reset": "tsx --env-file-if-exists=.env scripts/study/reset-participants.ts",
    "study:deprovision": "tsx --env-file-if-exists=.env scripts/study/deprovision-participants.ts",
    "db:local:up": "docker compose -f docker-compose.local.yml up -d",
    "db:local:down": "docker compose -f docker-compose.local.yml down",
    "db:local:logs": "docker compose -f docker-compose.local.yml logs -f postgres"
  },
  "dependencies": {
    "@blocknote/core": "^0.44.2",
    "@blocknote/mantine": "^0.44.2",
    "@blocknote/react": "^0.44.2",
    "@headlessui/react": "^2.2.9",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-table": "^8.21.3",
    "@types/nodemailer": "^7.0.4",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.5.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "fflate": "^0.8.3",
    "lucide-react": "^0.562.0",
    "next": "^15.1.3",
    "nodemailer": "^7.0.12",
    "openai": "^6.15.0",
    "postgres": "^3.4.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.6.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.7.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "playwright": "^1.61.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3"
  }
}
