# Database (Vercel Postgres)
# Vercel automatically provides POSTGRES_URL when you create a Postgres database
# For local development, you can use a local Postgres instance or Vercel's connection string
POSTGRES_URL="postgresql://user:password@host:5432/swag"

# OpenAI API
OPENAI_API_KEY="sk-..."

# SCORE classifier — max concurrent OpenAI calls per batch (A + per-subtype B
# share this pool). Tune to your OpenAI usage tier:
#   Tier 1 (500 RPM / 500K TPM):  8-10
#   Tier 2 (5,000 RPM / 2M TPM):  64  (TPM-bound; higher just triggers 429 backoff)
# Unset falls back to 32 in code. Hard cap is 128.
SCORE_LLM_CONCURRENCY=64

# Application URL
# Development
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Production
# NEXT_PUBLIC_APP_URL="https://your-domain.com"

# Authentication
# Generate a secure random string for JWT signing
# You can generate one with: openssl rand -base64 32
JWT_SECRET="your-random-secret-here-change-this-in-production"

# Email Configuration (for instructor magic links)
# Using Gmail SMTP
# 1. Enable 2-factor authentication on your Gmail account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Create an app password (select "Mail" and "Other")
# 4. Copy the 16-digit password (without spaces)
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="your-16-digit-app-password"  # Generated from Google App Passwords
EMAIL_FROM="SWAG <your-email@gmail.com>"  # Optional: customize sender name

# Only allow these email domains to receive magic links
EMAIL_DOMAIN_RESTRICTION_ENABLED="true"
ALLOWED_EMAIL_DOMAINS="vt.edu"

# Passcodes for instructor and administrator signup
INSTRUCTOR_PASSCODE="change-me"
ADMINISTRATOR_PASSCODE="change-me-admin"

# ── User study ───────────────────────────────────────────────────────────
# What the two versions are called in front of a participant. Defaults are
# Slate (intent-rule) and Clay (single Rules document); override to render the
# same screens as SCORE / Baseline for paper figures and talk recordings.
# NEXT_PUBLIC_ because the console and curation board read them client-side.
# NEXT_PUBLIC_STUDY_NAME_SCORE="Slate"
# NEXT_PUBLIC_STUDY_NAME_BASELINE="Clay"

# The three walkthrough films, by YouTube id (the part after ?v=). Block 1
# plays COMMON then its version's segment; block 2 plays only the other
# version's. Unset = the tutorial step shows a placeholder instead of a player.
# NEXT_PUBLIC_STUDY_DEMO_COMMON=""
# NEXT_PUBLIC_STUDY_DEMO_SCORE=""
# NEXT_PUBLIC_STUDY_DEMO_BASELINE=""

# Node Environment
NODE_ENV="development"
