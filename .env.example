# Database (Vercel Postgres)
# Vercel automatically provides POSTGRES_URL when you create a Postgres database
# For local development, you can use a local Postgres instance or Vercel's connection string
POSTGRES_URL="postgresql://user:password@host:5432/swag"

# OpenAI API
OPENAI_API_KEY="sk-..."

# SCORE classifier — max concurrent OpenAI calls per batch (A + per-subtype B
# share this pool). Tune to your OpenAI usage tier:
#   Tier 1 (500 RPM / 500K TPM):  8-10
#   Tier 2 (5,000 RPM / 2M TPM):  64  (TPM-bound; higher just triggers 429 backoff)
# Unset falls back to 32 in code. Hard cap is 128.
SCORE_LLM_CONCURRENCY=64

# Application URL
# Development
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Production
# NEXT_PUBLIC_APP_URL="https://your-domain.com"

# Authentication
# Generate a secure random string for JWT signing
# You can generate one with: openssl rand -base64 32
JWT_SECRET="your-random-secret-here-change-this-in-production"

# Email Configuration (for instructor magic links)
# Using Gmail SMTP
# 1. Enable 2-factor authentication on your Gmail account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Create an app password (select "Mail" and "Other")
# 4. Copy the 16-digit password (without spaces)
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="your-16-digit-app-password"  # Generated from Google App Passwords
EMAIL_FROM="SWAG <your-email@gmail.com>"  # Optional: customize sender name

# Only allow these email domains to receive magic links
EMAIL_DOMAIN_RESTRICTION_ENABLED="true"
ALLOWED_EMAIL_DOMAINS="vt.edu"

# Passcodes for instructor and administrator signup
INSTRUCTOR_PASSCODE="change-me"
ADMINISTRATOR_PASSCODE="change-me-admin"

# ── User study ───────────────────────────────────────────────────────────
# What the two versions are called in front of a participant. Defaults are
# Slate (intent-rule) and Clay (single Rules document); override to render the
# same screens as SCORE / Baseline for paper figures and talk recordings.
# NEXT_PUBLIC_ because the console and curation board read them client-side.
# NEXT_PUBLIC_STUDY_NAME_SCORE="Slate"
# NEXT_PUBLIC_STUDY_NAME_BASELINE="Clay"
# The simple version's two arms reuse those names — a participant runs one
# family for the whole session and never sees the other, so the names only have
# to tell the ARMS apart. Set these only for a figure that puts all four on one
# page.
# NEXT_PUBLIC_STUDY_NAME_SIMPLE_SCORE=""
# NEXT_PUBLIC_STUDY_NAME_SIMPLE_BASELINE=""

# The walkthrough films, by YouTube id (the part after ?v=). Block 1 plays the
# shared "getting around" segment then its version's; block 2 plays only the
# other version's. The shared segment is shot once per board (same narration),
# so each arm's first block sees its own board in it; COMMON alone is the
# fallback for both. Unset = the tutorial step shows a placeholder instead of a
# player.
# NEXT_PUBLIC_STUDY_DEMO_COMMON_SCORE=""
# NEXT_PUBLIC_STUDY_DEMO_COMMON_BASELINE=""
# NEXT_PUBLIC_STUDY_DEMO_COMMON=""
# NEXT_PUBLIC_STUDY_DEMO_SCORE=""
# NEXT_PUBLIC_STUDY_DEMO_BASELINE=""
# The simple version's films are its own — its boards do not have the controls
# the full version's footage teaches, so these deliberately do not fall back to
# the ids above. _COMMON_SIMPLE is the both-arms fallback for the shared segment.
# NEXT_PUBLIC_STUDY_DEMO_COMMON_SIMPLE_SCORE=""
# NEXT_PUBLIC_STUDY_DEMO_COMMON_SIMPLE_BASELINE=""
# NEXT_PUBLIC_STUDY_DEMO_COMMON_SIMPLE=""
# NEXT_PUBLIC_STUDY_DEMO_SIMPLE_SCORE=""
# NEXT_PUBLIC_STUDY_DEMO_SIMPLE_BASELINE=""

# ONE FILM PER BLOCK. Set these and the block plays a single video instead of
# the segments above: the concept, the shared screens (block 1 only) and the
# walkthrough, already joined in the edit. That order — concept first — is the
# reason they are joined outside the app; a segment list cannot put anything
# before the shared screens. Setting BLOCK1/BLOCK2 for a condition overrides
# the segment ids for that block; leaving them unset changes nothing.
#
# ANY YOUTUBE LINK WORKS. A watch URL, a Share-button youtu.be link (the `?si=`
# tag is fine), an /embed/ or /shorts/ URL, or the eleven-character id on its
# own. If a value is set but no id can be read from it, the walkthrough step
# says so and shows the value back, rather than mounting a player that loads a
# blank error page.
#
# Slate == *_SCORE, Clay == *_BASELINE (see NEXT_PUBLIC_STUDY_NAME_* above).
# NEXT_PUBLIC_STUDY_DEMO_BLOCK1_SIMPLE_SCORE=""      # block1-slate.mp4
# NEXT_PUBLIC_STUDY_DEMO_BLOCK1_SIMPLE_BASELINE=""   # block1-clay.mp4
# NEXT_PUBLIC_STUDY_DEMO_BLOCK2_SIMPLE_SCORE=""      # block2-slate.mp4
# NEXT_PUBLIC_STUDY_DEMO_BLOCK2_SIMPLE_BASELINE=""   # block2-clay.mp4
# The full version has the same four slots, unused for now.
# NEXT_PUBLIC_STUDY_DEMO_BLOCK1_SCORE=""
# NEXT_PUBLIC_STUDY_DEMO_BLOCK1_BASELINE=""
# NEXT_PUBLIC_STUDY_DEMO_BLOCK2_SCORE=""
# NEXT_PUBLIC_STUDY_DEMO_BLOCK2_BASELINE=""

# Node Environment
NODE_ENV="development"
